{
  "__inputs": [
    {
      "name": "DS_PATCHPROOF",
      "label": "PatchProof PostgreSQL",
      "description": "Select your existing PostgreSQL datasource",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "01  |  OPERATIONAL FINDINGS",
      "type": "stat",
      "description": "Greenbone + ZAP only. This is not a complete risk count; Nessus authenticated results have not been imported.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PATCHPROOF}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PATCHPROOF}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::integer AS \"Require analyst review\" FROM dashboard_findings WHERE asset <> 'MS2' AND status = 'Open';"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "mappings": []
        },
        "overrides": []
      },
      "transparent": false,
      "pluginVersion": "11.0.0"
    },
    {
      "id": 2,
      "title": "02  |  CRITICAL ASSET ASSURANCE",
      "type": "bargauge",
      "description": "These labels describe assessment coverage, not system safety. DC01 and WEB01 Nessus scans exist but are not imported. WIN-CL authenticated Nessus scan failed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PATCHPROOF}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PATCHPROOF}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  1::integer AS \"DC01 · Partial\",\n  1::integer AS \"WEB01 · Partial\",\n  0::integer AS \"WIN-CL · Coverage gap\";"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 15,
        "minVizHeight": 25,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ASSESSMENT GAP",
                  "color": "red"
                },
                "1": {
                  "text": "PARTIAL COVERAGE",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "transparent": false,
      "pluginVersion": "11.0.0"
    },
    {
      "id": 3,
      "title": "03  |  OPERATIONAL KEV EXPOSURE",
      "type": "stat",
      "description": "Zero KEV matches in current imported operational CVEs. Two KEV CVEs appear in MS2 training data. Coverage incomplete; zero does not mean safe.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PATCHPROOF}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PATCHPROOF}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT cve)::integer AS \"KEV matches · operational\" FROM dashboard_cve_intelligence WHERE asset <> 'MS2' AND kev = 'Yes';"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "transparent": false,
      "pluginVersion": "11.0.0"
    },
    {
      "id": 4,
      "title": "04  |  REMEDIATION ASSURANCE",
      "type": "stat",
      "description": "No before/after verification scans are in the current dataset. This panel reflects recorded closure labels only and does not establish verified risk reduction.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PATCHPROOF}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PATCHPROOF}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN COUNT(*) FILTER (WHERE status IN ('Verified Remediated','Verified Closed')) = 0\n  THEN 0 ELSE 1 END::integer AS \"Remediation verification\"\nFROM dashboard_findings WHERE asset <> 'MS2';"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT VERIFIED",
                  "color": "orange"
                },
                "1": {
                  "text": "REVIEW VERIFIED CLOSURES",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "transparent": false,
      "pluginVersion": "11.0.0"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "PatchProof",
    "Executive",
    "Vulnerability Management"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "PatchProof | Executive Cyber Risk Overview",
  "uid": null,
  "version": 1,
  "weekStart": "",
  "description": "Executive baseline | PARTIAL ASSESSMENT. Greenbone + ZAP only; Nessus findings not imported. MS2 is a deliberately vulnerable training asset and is excluded from operational risk metrics. No verified remediation baseline comparison exists."
}
